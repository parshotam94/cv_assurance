# VisionTrust Assurance Configuration
APP_NAME=VisionTrust Assurance
APP_ENV=production
DEBUG=false
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./data/visiontrust.db
STORAGE_DIR=./data
KEY_STORAGE_DIR=./data/keys
MAX_UPLOAD_SIZE_MB=500
AIR_GAPPED_MODE=true

# Threshold configurations
DUPLICATE_SIMILARITY_THRESHOLD=0.92
OOD_PERCENTILE_THRESHOLD=0.95
TRIGGER_PATCH_SIMILARITY_THRESHOLD=0.85
RISK_REVIEW_THRESHOLD=50
RISK_QUARANTINE_THRESHOLD=80
BEHAVIOURAL_BATTERY_SAMPLES=100
